{
  "name": "api-recarga",
  "compatibility_date": "2024-02-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".vercel/output/static",
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "tu-hyperdrive-id" // Deberás reemplazar esto con el ID real de tu Hyperdrive en Cloudflare
    }
  ]
}
